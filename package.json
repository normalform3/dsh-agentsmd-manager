{
  "name": "dsh-agentsmd-manager",
  "description": "Manage AGENTS.md across DSH workspaces from one place: search, preview, edit, use templates, and review AI suggestions.",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "README.md", "README.en.md"],
  "scripts": { "test": "node --test", "check": "node --check index.js && node --check client.js && node --test" },
  "repository": "https://github.com/normalform3/dsh-agentsmd-manager",
  "license": "MIT",
  "keywords": ["dsh-plugin", "agents-md", "workspace"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots"] } }
}
